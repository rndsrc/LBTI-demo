# Copy to .env. Only the API key is required; the other values show the defaults.
ANTHROPIC_API_KEY=

# MODEL=claude-sonnet-5-5         # or claude-haiku-5-5 for a cheaper demo
# MAX_TOKENS=2048                 # per answer
# MAX_SEARCHES=5                  # searches per question before an answer is forced
# MAX_QUESTION_CHARS=2000
# MAX_TURNS=20                    # questions per conversation
# RATE_PER_HOUR=30                # questions per client IP per hour
# PDF_URL=https://scienceops.lbto.org/wp-content/uploads/2024/05/LBTI_user_manual_v0.11.pdf
# PDF_VERSION=v0.11
# MANUAL_URL=https://scienceops.lbto.org/lbti/lbti-users-manual/

# Docker only
# LBTI_IMAGE=<username>/lbti-demo # docker compose: run this published image instead of building
# PORT=8000                       # host port
# FORWARDED_ALLOW_IPS=172.17.0.1  # behind a reverse proxy: its address, so client IPs come from X-Forwarded-For
